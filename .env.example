# SonexLabs credentials — get your key at https://www.sonexlabs.com/configurations/developer
SONEX_API_KEY=vsk_...

# Voice configuration — list available voices with: curl https://api.sonexlabs.com/v1/voices -H "Authorization: Bearer $SONEX_API_KEY"
# SONEX_VOICE_ID is required — there is no default voice
SONEX_VOICE_ID=
SONEX_LANGUAGE=en

# LLM
OPENAI_API_KEY=sk-...

# STT
DEEPGRAM_API_KEY=...

# WebRTC / Telephony
PUBLIC_HOST=your-ngrok-host.ngrok.io  # for Twilio/Exotel ngrok tunnel
